+#[tokio::test]
+async fn completed_child_during_parent_turn_does_not_start_another_turn() -> Result<()> {
+    let server = responses::start_mock_server().await;
+    responses::mount_sse_once_match(
+        &server,
+        |request: &wiremock::Request| {
+            let body = String::from_utf8_lossy(&request.body);
+            body.contains(PARENT_PROMPT) && !body.contains(SPAWN_CALL_ID)
+        },
+        responses::sse(vec![
+            responses::ev_response_created("parent-spawn"),
+            responses::ev_function_call_with_namespace(
+                SPAWN_CALL_ID,
+                "collaboration",
+                "spawn_agent",
+                &serde_json::to_string(&json!({
+                    "message": CHILD_PROMPT,
+                    "task_name": "worker",
+                    "fork_turns": "none",
+                }))?,
+            ),
+            responses::ev_completed("parent-spawn"),
+        ]),
+    )
+    .await;
+    responses::mount_response_once_match(
+        &server,
+        |request: &wiremock::Request| {
+            let body = String::from_utf8_lossy(&request.body);
+            body.contains(SPAWN_CALL_ID) && !body.contains("Message Type: FINAL_ANSWER")
+        },
+        responses::sse_response(responses::sse(vec![
+            responses::ev_response_created("parent-busy"),
+            responses::ev_assistant_message("parent-message", "parent finished other work"),
+            responses::ev_completed("parent-busy"),
+        ]))
+        .set_delay(Duration::from_secs(2)),
+    )
+    .await;
+    responses::mount_response_once_match(
+        &server,
+        |request: &wiremock::Request| String::from_utf8_lossy(&request.body).contains(CHILD_PROMPT),
+        responses::sse_response(responses::sse(vec![
+            responses::ev_response_created("child-finished"),
+            responses::ev_assistant_message("child-message", "child done"),
+            responses::ev_completed("child-finished"),
+        ]))
+        .set_delay(Duration::from_millis(250)),
+    )
+    .await;
+    let completion_request = responses::mount_sse_once_match(
+        &server,
+        |request: &wiremock::Request| {
+            let body = String::from_utf8_lossy(&request.body);
+            body.contains("Message Type: FINAL_ANSWER") && body.contains("child done")
+        },
+        responses::sse(vec![
+            responses::ev_response_created("parent-read-completion"),
+            responses::ev_assistant_message("parent-read-message", "parent saw child"),
+            responses::ev_completed("parent-read-completion"),
+        ]),
+    )
+    .await;
+
+    let codex_home = TempDir::new()?;
+    MockResponsesConfig::new(&server.uri())
+        .with_extra_config(
+            "[features.multi_agent_v2]\nenabled = true\n[agents]\nwake_parent_on_completion = true",
+        )
+        .write(codex_home.path())?;
+    write_models_cache(codex_home.path()).await?;
+    let mut app = TestAppServer::builder()
+        .with_codex_home(codex_home.path())
+        .build_initialized()
+        .await?;
+    let parent = app.start_thread(ThreadStartParams::default()).await?.thread;
+    let TurnStartResponse { turn } = app
+        .request(|request_id| ClientRequest::TurnStart {
+            request_id,
+            params: TurnStartParams {
+                thread_id: parent.id.clone(),
+                input: vec![UserInput::Text {
+                    text: PARENT_PROMPT.to_string(),
+                    text_elements: Vec::new(),
+                }],
+                ..Default::default()
+            },
+        })
+        .await?;
+    timeout(
+        Duration::from_secs(10),
+        app.read_stream_until_matching_notification(
+            "child finished during parent turn",
+            |notification| {
+                notification.method == "turn/completed"
+                    && notification
+                        .params
+                        .as_ref()
+                        .is_some_and(|params| params["threadId"] != parent.id)
+            },
+        ),
+    )
+    .await??;
+    assert!(
+        timeout(
+            Duration::from_millis(100),
+            app.read_stream_until_matching_notification("parent still busy", |notification| {
+                notification.method == "turn/completed"
+                    && notification.params.as_ref().is_some_and(|params| {
+                        params["threadId"] == parent.id && params["turn"]["id"] == turn.id
+                    })
+            }),
+        )
+        .await
+        .is_err()
+    );
+    timeout(
+        Duration::from_secs(10),
+        app.read_stream_until_matching_notification("parent turn completed", |notification| {
+            notification.method == "turn/completed"
+                && notification.params.as_ref().is_some_and(|params| {
+                    params["threadId"] == parent.id && params["turn"]["id"] == turn.id
+                })
+        }),
+    )
+    .await??;
+    assert!(
+        timeout(
+            Duration::from_millis(400),
+            app.read_stream_until_matching_notification(
+                "unexpected extra parent turn",
+                |notification| {
+                    notification.method == "turn/started"
+                        && notification.params.as_ref().is_some_and(|params| {
+                            params["threadId"] == parent.id && params["turn"]["id"] != turn.id
+                        })
+                }
+            ),
+        )
+        .await
+        .is_err()
+    );
+    if completion_request.requests().is_empty() {
+        timeout(
+            Duration::from_secs(10),
+            app.start_turn_and_wait_for_completion(TurnStartParams {
+                thread_id: parent.id.clone(),
+                input: vec![UserInput::Text {
+                    text: NEXT_USER_PROMPT.to_string(),
+                    text_elements: Vec::new(),
+                }],
+                ..Default::default()
+            }),
+        )
+        .await??;
+    } else {
+        let request = completion_request.single_request();
+        assert_eq!(
+            request.body_json()["client_metadata"]["turn_id"],
+            json!(turn.id)
+        );
+    }
+    assert_eq!(completion_request.requests().len(), 1);
+    Ok(())
+}

+        Some(ThreadSource::Subagent),
+        None,
+        None,
+        None,
+        None,
+    ))
+    .await
+    .expect("start nested parent");
+    assert!(parent.thread.session.active_turn.lock().await.is_none());
+    let busy_source = SessionSource::SubAgent(SubAgentSource::Other("busy".to_string()));
+    let _capacity_guard = control
+        .execution_guard(MultiAgentVersion::V2, &busy_source)
+        .expect("occupy all non-root execution capacity");
+    let child_path = parent_path.join("child").expect("child path");
+    let child_id = ThreadId::new();
+    control
+        .notify_parent_of_terminal_turn(
+            AgentTurnOutcome {
+                thread_id: child_id,
+                turn_id: "child-terminal".to_string(),
+                source: SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+                    parent_thread_id: parent.thread_id,
+                    depth: 2,
+                    agent_path: Some(child_path.clone()),
+                    agent_nickname: None,
+                    agent_role: None,
+                }),
+                parent_turn_id: None,
+                initiating_agent_path: None,
+                status: AgentStatus::Completed(Some("done".to_string())),
+                wake_parent_on_completion: true,
+            },
+            &parent.thread.session.services.rollout_thread_trace,
+        )
+        .await;
+
+    let notifications = harness
+        .manager
+        .captured_ops()
+        .into_iter()
+        .filter_map(|(id, op)| match op {
+            Op::InterAgentCommunication {
+                communication,
+                wake_policy,
+                ..
+            } if id == parent.thread_id && communication.author == child_path => {
+                Some((communication, wake_policy))
+            }
+            _ => None,
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(notifications.len(), 1);
+    let (communication, wake_policy) = &notifications[0];
+    assert!(!communication.trigger_turn);
+    assert_eq!(*wake_policy, InterAgentWakePolicy::CompletionQueueOnly);
+    timeout(Duration::from_secs(5), async {
+        loop {
+            if parent
+                .thread
+                .session
+                .input_queue
+                .has_pending_mailbox_items()
+                .await
+            {
+                break;
+            }
+            sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await
+    .expect("full capacity must preserve the parent's queued result");
+}

+//! Parent completion delivery is observable through the app-server turn stream.
+
+use anyhow::Result;
+use app_test_support::MockResponsesConfig;
+use app_test_support::TestAppServer;
+use app_test_support::write_models_cache;
+use codex_app_server_protocol::ClientRequest;
+use codex_app_server_protocol::ThreadStartParams;
+use codex_app_server_protocol::TurnCompletedNotification;
+use codex_app_server_protocol::TurnInterruptParams;
+use codex_app_server_protocol::TurnInterruptResponse;
+use codex_app_server_protocol::TurnStartParams;
+use codex_app_server_protocol::TurnStartResponse;
+use codex_app_server_protocol::TurnStartedNotification;
+use codex_app_server_protocol::TurnStatus;
+use codex_app_server_protocol::UserInput;
+use core_test_support::responses;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use std::time::Duration;
+use tempfile::TempDir;
+use tokio::time::timeout;
+
+const PARENT_PROMPT: &str = "spawn the completion worker";
+const CHILD_PROMPT: &str = "finish the completion task";
+const SPAWN_CALL_ID: &str = "completion-spawn";
+const NEXT_USER_PROMPT: &str = "read the queued completion";
+
+#[test_case::test_case(true, false; "completed_wake")]
+#[test_case::test_case(true, true; "errored_wake")]
+#[test_case::test_case(false, false; "completed_queued")]
+#[test_case::test_case(false, true; "errored_queued")]
+#[tokio::test]
+async fn terminal_child_obeys_parent_wake_switch(wake_enabled: bool, error: bool) -> Result<()> {
+    let server = responses::start_mock_server().await;
+    let parent_spawn = responses::mount_sse_once_match(
+        &server,
+        |request: &wiremock::Request| {
+            let body = String::from_utf8_lossy(&request.body);
+            body.contains(PARENT_PROMPT) && !body.contains(SPAWN_CALL_ID)
+        },
+        responses::sse(vec![
+            responses::ev_response_created("parent-spawn"),
+            responses::ev_function_call_with_namespace(
+                SPAWN_CALL_ID,
+                "collaboration",
+                "spawn_agent",
+                &serde_json::to_string(&json!({
+                    "message": CHILD_PROMPT,
+                    "task_name": "worker",
+                    "fork_turns": "none",
+                }))?,
+            ),
+            responses::ev_completed("parent-spawn"),
+        ]),
+    )
+    .await;
+    let parent_finished = responses::mount_sse_once_match(
+        &server,
+        |request: &wiremock::Request| {
+            let body = String::from_utf8_lossy(&request.body);
+            body.contains(SPAWN_CALL_ID) && !body.contains("Message Type: FINAL_ANSWER")
+        },
+        responses::sse(vec![
+            responses::ev_response_created("parent-finished"),
+            responses::ev_assistant_message("parent-message", "parent waiting"),
+            responses::ev_completed("parent-finished"),
+        ]),
+    )
+    .await;
+    let child_events = if error {
+        vec![responses::ev_response_created("child-finished")]
+    } else {
+        vec![
+            responses::ev_response_created("child-finished"),
+            responses::ev_assistant_message("child-message", "child done"),
+            responses::ev_completed("child-finished"),
+        ]
+    };
+    let child = responses::mount_response_once_match(
+        &server,
+        |request: &wiremock::Request| String::from_utf8_lossy(&request.body).contains(CHILD_PROMPT),
+        responses::sse_response(responses::sse(child_events)).set_delay(Duration::from_millis(750)),
+    )
+    .await;
+    let expected_payload = if error {
+        "Agent errored:"
+    } else {
+        "child done"
+    };
+    let wake = responses::mount_sse_once_match(
+        &server,
+        move |request: &wiremock::Request| {
+            let body = String::from_utf8_lossy(&request.body);
+            body.contains("Message Type: FINAL_ANSWER") && body.contains(expected_payload)
+        },
+        responses::sse(vec![
+            responses::ev_response_created("parent-woken"),
+            responses::ev_assistant_message("wake-message", "parent resumed"),
+            responses::ev_completed("parent-woken"),
+        ]),
+    )
+    .await;
+
+    let codex_home = TempDir::new()?;
+    MockResponsesConfig::new(&server.uri())
+        .with_extra_config(&format!(
+            "[features.multi_agent_v2]\nenabled = true\n[agents]\nwake_parent_on_completion = {wake_enabled}"
+        ))
+        .write(codex_home.path())?;
+    write_models_cache(codex_home.path()).await?;
+    let mut app = TestAppServer::builder()
+        .with_codex_home(codex_home.path())
+        .build_initialized()
+        .await?;
+    let parent = app.start_thread(ThreadStartParams::default()).await?.thread;
+    let initial = timeout(
+        Duration::from_secs(25),
+        app.start_turn_and_wait_for_completion(TurnStartParams {
+            thread_id: parent.id.clone(),
+            input: vec![UserInput::Text {
+                text: PARENT_PROMPT.to_string(),
+                text_elements: Vec::new(),
+            }],
+            ..Default::default()
+        }),
+    )
+    .await??;
+    let next_turn_id = if wake_enabled {
+        let started = timeout(
+            Duration::from_secs(10),
+            app.read_stream_until_matching_notification("parent wake", |notification| {
+                notification.method == "turn/started"
+                    && notification.params.as_ref().is_some_and(|params| {
+                        params["threadId"] == parent.id && params["turn"]["id"] != initial.turn.id
+                    })
+            }),
+        )
+        .await??;
+        let started: TurnStartedNotification =
+            serde_json::from_value(started.params.expect("turn start params"))?;
+        timeout(
+            Duration::from_secs(10),
+            app.read_stream_until_matching_notification("parent wake completion", |notification| {
+                notification.method == "turn/completed"
+                    && notification.params.as_ref().is_some_and(|params| {
+                        params["threadId"] == parent.id && params["turn"]["id"] == started.turn.id
+                    })
+            }),
+        )
+        .await??;
+        started.turn.id
+    } else {
+        timeout(
+            Duration::from_secs(10),
+            app.read_stream_until_matching_notification("child completion", |notification| {
+                notification.method == "turn/completed"
+                    && notification
+                        .params
+                        .as_ref()
+                        .is_some_and(|params| params["threadId"] != parent.id)
+            }),
+        )
+        .await??;
+        assert!(
+            timeout(
+                Duration::from_millis(400),
+                app.read_stream_until_matching_notification(
+                    "unexpected parent wake",
+                    |notification| {
+                        notification.method == "turn/started"
+                            && notification.params.as_ref().is_some_and(|params| {
+                                params["threadId"] == parent.id
+                                    && params["turn"]["id"] != initial.turn.id
+                            })
+                    }
+                ),
+            )
+            .await
+            .is_err()
+        );
+        timeout(
+            Duration::from_secs(10),
+            app.start_turn_and_wait_for_completion(TurnStartParams {
+                thread_id: parent.id.clone(),
+                input: vec![UserInput::Text {
+                    text: NEXT_USER_PROMPT.to_string(),
+                    text_elements: Vec::new(),
+                }],
+                ..Default::default()
+            }),
+        )
+        .await??
+        .turn
+        .id
+    };
+    assert_eq!(child.requests().len(), 1);
+    assert_eq!(wake.requests().len(), 1);
+    assert_eq!(parent_spawn.requests().len(), 1);
+    assert_eq!(parent_finished.requests().len(), 1);
+    assert!(
+        timeout(
+            Duration::from_millis(300),
+            app.read_stream_until_matching_notification(
+                "unexpected extra parent turn",
+                |notification| {
+                    notification.method == "turn/started"
+                        && notification.params.as_ref().is_some_and(|params| {
+                            params["threadId"] == parent.id
+                                && params["turn"]["id"] != initial.turn.id
+                                && params["turn"]["id"] != next_turn_id
+                        })
+                }
+            ),
+        )
+        .await
+        .is_err()
+    );
+    let request = wake.single_request();
+    assert_eq!(
+        String::from_utf8_lossy(&serde_json::to_vec(&request.body_json())?)
+            .matches("Message Type: FINAL_ANSWER")
+            .count(),
+        1
+    );
+    Ok(())
+}
+
+#[test_case::test_case(true; "wake")]
+#[test_case::test_case(false; "queue")]
+#[tokio::test]
+async fn interrupted_child_obeys_parent_wake_switch_once(wake_enabled: bool) -> Result<()> {
+    let server = responses::start_mock_server().await;
+    let parent_spawn = responses::mount_sse_once_match(
+        &server,
+        |request: &wiremock::Request| {
+            let body = String::from_utf8_lossy(&request.body);
+            body.contains(PARENT_PROMPT) && !body.contains(SPAWN_CALL_ID)
+        },
+        responses::sse(vec![
+            responses::ev_response_created("parent-spawn"),
+            responses::ev_function_call_with_namespace(
+                SPAWN_CALL_ID,
+                "collaboration",
+                "spawn_agent",
+                &serde_json::to_string(&json!({
+                    "message": CHILD_PROMPT,
+                    "task_name": "worker",
+                    "fork_turns": "none",
+                }))?,
+            ),
+            responses::ev_completed("parent-spawn"),
+        ]),
+    )
+    .await;
+    let parent_finished = responses::mount_sse_once_match(
+        &server,
+        |request: &wiremock::Request| {
+            let body = String::from_utf8_lossy(&request.body);
+            body.contains(SPAWN_CALL_ID) && !body.contains("Message Type: FINAL_ANSWER")
+        },
+        responses::sse(vec![
+            responses::ev_response_created("parent-finished"),
+            responses::ev_assistant_message("parent-message", "parent waiting"),
+            responses::ev_completed("parent-finished"),
+        ]),
+    )
+    .await;
+    let child = responses::mount_response_once_match(
+        &server,
+        |request: &wiremock::Request| String::from_utf8_lossy(&request.body).contains(CHILD_PROMPT),
+        responses::sse_response(responses::sse(vec![
+            responses::ev_response_created("child-finished"),
+            responses::ev_assistant_message("child-message", "too late"),
+            responses::ev_completed("child-finished"),
+        ]))
+        .set_delay(Duration::from_secs(8)),
+    )
+    .await;
+    let wake = responses::mount_sse_once_match(
+        &server,
+        |request: &wiremock::Request| {
+            let body = String::from_utf8_lossy(&request.body);
+            body.contains("Message Type: FINAL_ANSWER") && body.contains("Agent interrupted.")
+        },
+        responses::sse(vec![
+            responses::ev_response_created("parent-woken"),
+            responses::ev_assistant_message("wake-message", "parent saw interruption"),
+            responses::ev_completed("parent-woken"),
+        ]),
+    )
+    .await;
+
+    let codex_home = TempDir::new()?;
+    MockResponsesConfig::new(&server.uri())
+        .with_extra_config(&format!("[features.multi_agent_v2]\nenabled = true\n[features]\ninstant_interrupt = true\n[agents]\nwake_parent_on_completion = {wake_enabled}"))
+        .write(codex_home.path())?;
+    write_models_cache(codex_home.path()).await?;
+    let mut app = TestAppServer::builder()
+        .with_codex_home(codex_home.path())
+        .build_initialized()
+        .await?;
+    let parent = app.start_thread(ThreadStartParams::default()).await?.thread;
+    let initial = timeout(
+        Duration::from_secs(25),
+        app.start_turn_and_wait_for_completion(TurnStartParams {
+            thread_id: parent.id.clone(),
+            input: vec![UserInput::Text {
+                text: PARENT_PROMPT.to_string(),
+                text_elements: Vec::new(),
+            }],
+            ..Default::default()
+        }),
+    )
+    .await??;
+    timeout(Duration::from_secs(5), async {
+        loop {
+            if child.requests().len() == 1 {
+                break;
+            }
+            tokio::task::yield_now().await;
+        }
+    })
+    .await?;
+    let child_started = timeout(
+        Duration::from_secs(5),
+        app.read_stream_until_matching_notification("child turn started", |notification| {
+            notification.method == "turn/started"
+                && notification
+                    .params
+                    .as_ref()
+                    .is_some_and(|params| params["threadId"] != parent.id)
+        }),
+    )
+    .await??;
+    let child_started: TurnStartedNotification =
+        serde_json::from_value(child_started.params.expect("child turn start params"))?;
+    let _: TurnInterruptResponse = app
+        .request(|request_id| ClientRequest::TurnInterrupt {
+            request_id,
+            params: TurnInterruptParams {
+                thread_id: child_started.thread_id.clone(),
+                turn_id: child_started.turn.id,
+            },
+        })
+        .await?;
+    let interrupted = timeout(
+        Duration::from_secs(5),
+        app.read_stream_until_matching_notification("child interrupted", |notification| {
+            notification.method == "turn/completed"
+                && notification
+                    .params
+                    .as_ref()
+                    .is_some_and(|params| params["threadId"] == child_started.thread_id)
+        }),
+    )
+    .await??;
+    let interrupted: TurnCompletedNotification =
+        serde_json::from_value(interrupted.params.expect("child completion params"))?;
+    assert_eq!(interrupted.turn.status, TurnStatus::Interrupted);
+    if !wake_enabled {
+        assert!(
+            timeout(
+                Duration::from_millis(400),
+                app.read_stream_until_matching_notification(
+                    "unexpected parent wake",
+                    |notification| {
+                        notification.method == "turn/started"
+                            && notification.params.as_ref().is_some_and(|params| {
+                                params["threadId"] == parent.id
+                                    && params["turn"]["id"] != initial.turn.id
+                            })
+                    }
+                )
+            )
+            .await
+            .is_err()
+        );
+        app.start_turn_and_wait_for_completion(TurnStartParams {
+            thread_id: parent.id.clone(),
+            input: vec![UserInput::Text {
+                text: NEXT_USER_PROMPT.to_string(),
+                text_elements: Vec::new(),
+            }],
+            ..Default::default()
+        })
+        .await?;
+        assert_eq!(wake.requests().len(), 1);
+        return Ok(());
+    }
+    let parent_wake = timeout(
+        Duration::from_secs(5),
+        app.read_stream_until_matching_notification("parent wake", |notification| {
+            notification.method == "turn/started"
+                && notification.params.as_ref().is_some_and(|params| {
+                    params["threadId"] == parent.id && params["turn"]["id"] != initial.turn.id
+                })
+        }),
+    )
+    .await??;
+    let parent_wake: TurnStartedNotification =
+        serde_json::from_value(parent_wake.params.expect("parent wake params"))?;
+    timeout(
+        Duration::from_secs(5),
+        app.read_stream_until_matching_notification("parent wake completed", |notification| {
+            notification.method == "turn/completed"
+                && notification.params.as_ref().is_some_and(|params| {
+                    params["threadId"] == parent.id && params["turn"]["id"] == parent_wake.turn.id
+                })
+        }),
+    )
+    .await??;
+    assert_eq!(wake.requests().len(), 1);
+    assert_eq!(parent_spawn.requests().len(), 1);
+    assert_eq!(parent_finished.requests().len(), 1);
+    Ok(())
+}
+
+#[tokio::test]
+async fn completed_child_during_parent_turn_does_not_start_another_turn() -> Result<()> {
+    let server = responses::start_mock_server().await;
+    let parent_spawn = responses::mount_sse_once_match(
+        &server,
+        |request: &wiremock::Request| {
+            let body = String::from_utf8_lossy(&request.body);
+            body.contains(PARENT_PROMPT) && !body.contains(SPAWN_CALL_ID)
+        },
+        responses::sse(vec![
+            responses::ev_response_created("parent-spawn"),
+            responses::ev_function_call_with_namespace(
+                SPAWN_CALL_ID,
+                "collaboration",
+                "spawn_agent",
+                &serde_json::to_string(&json!({
+                    "message": CHILD_PROMPT,
+                    "task_name": "worker",
+                    "fork_turns": "none",
+                }))?,
+            ),
+            responses::ev_completed("parent-spawn"),
+        ]),
+    )
+    .await;
+    let parent_finished = responses::mount_response_once_match(
+        &server,
+        |request: &wiremock::Request| {
+            let body = String::from_utf8_lossy(&request.body);
+            body.contains(SPAWN_CALL_ID) && !body.contains("Message Type: FINAL_ANSWER")
+        },
+        responses::sse_response(responses::sse(vec![
+            responses::ev_response_created("parent-busy"),
+            responses::ev_assistant_message("parent-message", "parent finished other work"),
+            responses::ev_completed("parent-busy"),
+        ]))
+        .set_delay(Duration::from_secs(2)),
+    )
+    .await;
+    responses::mount_response_once_match(
+        &server,
+        |request: &wiremock::Request| String::from_utf8_lossy(&request.body).contains(CHILD_PROMPT),
+        responses::sse_response(responses::sse(vec![
+            responses::ev_response_created("child-finished"),
+            responses::ev_assistant_message("child-message", "child done"),
+            responses::ev_completed("child-finished"),
+        ]))
+        .set_delay(Duration::from_millis(250)),
+    )
+    .await;
+    let completion_request = responses::mount_sse_once_match(
+        &server,
+        |request: &wiremock::Request| {
+            let body = String::from_utf8_lossy(&request.body);
+            body.contains("Message Type: FINAL_ANSWER") && body.contains("child done")
+        },
+        responses::sse(vec![
+            responses::ev_response_created("parent-read-completion"),
+            responses::ev_assistant_message("parent-read-message", "parent saw child"),
+            responses::ev_completed("parent-read-completion"),
+        ]),
+    )
+    .await;
+
+    let codex_home = TempDir::new()?;
+    MockResponsesConfig::new(&server.uri())
+        .with_extra_config(
+            "[features.multi_agent_v2]\nenabled = true\n[agents]\nwake_parent_on_completion = true",
+        )
+        .write(codex_home.path())?;
+    write_models_cache(codex_home.path()).await?;
+    let mut app = TestAppServer::builder()
+        .with_codex_home(codex_home.path())
+        .build_initialized()
+        .await?;
+    let parent = app.start_thread(ThreadStartParams::default()).await?.thread;
+    let TurnStartResponse { turn } = app
+        .request(|request_id| ClientRequest::TurnStart {
+            request_id,
+            params: TurnStartParams {
+                thread_id: parent.id.clone(),
+                input: vec![UserInput::Text {
+                    text: PARENT_PROMPT.to_string(),
+                    text_elements: Vec::new(),
+                }],
+                ..Default::default()
+            },
+        })
+        .await?;
+    timeout(
+        Duration::from_secs(10),
+        app.read_stream_until_matching_notification(
+            "child finished during parent turn",
+            |notification| {
+                notification.method == "turn/completed"
+                    && notification
+                        .params
+                        .as_ref()
+                        .is_some_and(|params| params["threadId"] != parent.id)
+            },
+        ),
+    )
+    .await??;
+    assert!(
+        timeout(
+            Duration::from_millis(100),
+            app.read_stream_until_matching_notification("parent still busy", |notification| {
+                notification.method == "turn/completed"
+                    && notification.params.as_ref().is_some_and(|params| {
+                        params["threadId"] == parent.id && params["turn"]["id"] == turn.id
+                    })
+            }),
+        )
+        .await
+        .is_err()
+    );
+    timeout(
+        Duration::from_secs(10),
+        app.read_stream_until_matching_notification("parent turn completed", |notification| {
+            notification.method == "turn/completed"
+                && notification.params.as_ref().is_some_and(|params| {
+                    params["threadId"] == parent.id && params["turn"]["id"] == turn.id
+                })
+        }),
+    )
+    .await??;
+    assert!(
+        timeout(
+            Duration::from_millis(400),
+            app.read_stream_until_matching_notification(
+                "unexpected extra parent turn",
+                |notification| {
+                    notification.method == "turn/started"
+                        && notification.params.as_ref().is_some_and(|params| {
+                            params["threadId"] == parent.id && params["turn"]["id"] != turn.id
+                        })
+                }
+            ),
+        )
+        .await
+        .is_err()
+    );
+    if completion_request.requests().is_empty() {
+        timeout(
+            Duration::from_secs(10),
+            app.start_turn_and_wait_for_completion(TurnStartParams {
+                thread_id: parent.id.clone(),
+                input: vec![UserInput::Text {
+                    text: NEXT_USER_PROMPT.to_string(),
+                    text_elements: Vec::new(),
+                }],
+                ..Default::default()
+            }),
+        )
+        .await??;
+    } else {
+        let request = completion_request.single_request();
+        assert_eq!(
+            request.body_json()["client_metadata"]["turn_id"],
+            json!(turn.id)
+        );
+    }
+    assert_eq!(completion_request.requests().len(), 1);
+    assert_eq!(parent_spawn.requests().len(), 1);
+    assert_eq!(parent_finished.requests().len(), 1);
+    Ok(())
+}

diff --git a/codex-rs/core/src/session/parent_completion_tests.rs b/codex-rs/core/src/session/parent_completion_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e2da9fef3c426b300518979a36390772439c4f1f
--- /dev/null
+++ b/codex-rs/core/src/session/parent_completion_tests.rs
@@ -0,0 +1,53 @@
+use super::make_session_and_context;
+use crate::session::handlers;
+use crate::state::ActiveTurn;
+use codex_extension_items::sleep::SleepItem;
+use codex_protocol::AgentPath;
+use codex_protocol::protocol::InterAgentCommunication;
+use codex_protocol::protocol::InterAgentWakePolicy;
+use pretty_assertions::assert_eq;
+use std::sync::Arc;
+
+#[test_case::test_case(InterAgentWakePolicy::CompletionQueueOnly, false; "disabled_or_full")]
+#[test_case::test_case(InterAgentWakePolicy::CompletionIfIdle, true; "running_parent")]
+#[tokio::test]
+async fn completion_keeps_mail_queued_even_with_durable_sleep(
+    policy: InterAgentWakePolicy,
+    busy: bool,
+) {
+    let (session, _) = make_session_and_context().await;
+    let session = Arc::new(session);
+    session.services.thread_extension_data.insert(SleepItem {
+        id: "sleep".to_string(),
+        duration_ms: 60_000,
+    });
+    if busy {
+        *session.active_turn.lock().await = Some(ActiveTurn::default());
+    }
+    let communication = InterAgentCommunication::new(
+        AgentPath::try_from("/root/child").unwrap(),
+        AgentPath::root(),
+        Vec::new(),
+        "Message Type: FINAL_ANSWER\nPayload: done".to_string(),
+        /*trigger_turn*/ false,
+    );
+    handlers::inter_agent_communication(
+        &session,
+        "completion".to_string(),
+        communication.clone(),
+        Default::default(),
+        policy,
+    )
+    .await;
+    assert_eq!(session.active_turn.lock().await.is_some(), busy);
+    *session.active_turn.lock().await = None;
+    // The deferred scheduler also must respect the completion's queue-only admission.
+    session.maybe_start_turn_for_pending_work().await;
+    assert!(session.active_turn.lock().await.is_none());
+    assert_eq!(
+        session.input_queue.drain_mailbox_input_items().await.0,
+        vec![crate::session::TurnInput::InterAgentCommunication(
+            communication
+        )]
+    );
+}

+//! Preserve a thread's provider across model changes and resumed histories.
+
+use super::*;
+
+pub(super) fn ensure_model_provider_binding(
+    config: &Config,
+    bound_provider: &str,
+    model: &str,
+) -> Result<(), JSONRPCErrorError> {
+    let selected_provider = config
+        .model_provider_routes
+        .get(model)
+        .map(String::as_str)
+        .unwrap_or(&config.unrouted_model_provider_id);
+    if selected_provider != bound_provider {
+        return Err(invalid_request(format!(
+            "model `{model}` resolves to model provider `{selected_provider}` and cannot run on session provider `{bound_provider}`"
+        )));
+    }
+    Ok(())
+}
+
+pub(super) fn historical_provider(
+    source: Option<&StoredThread>,
+    metadata: Option<&ThreadMetadata>,
+    history: &InitialHistory,
+) -> Option<String> {
+    source
+        .map(|thread| thread.model_provider.as_str())
+        .filter(|provider| !provider.is_empty())
+        .or_else(|| metadata.map(|metadata| metadata.model_provider.as_str()))
+        .or_else(|| match history {
+            InitialHistory::Resumed(resumed) => resumed.history.iter().find_map(|item| {
+                if let RolloutItem::SessionMeta(meta) = item
+                    && meta.meta.id == resumed.conversation_id
+                {
+                    meta.meta.model_provider.as_deref()
+                } else {
+                    None
+                }
+            }),
+            _ => None,
+        })
+        .map(str::to_string)
+}
+
+pub(super) fn ensure_resumed_provider_binding(
+    config: &Config,
+    bound_provider: Option<&str>,
+    persisted_model: Option<&str>,
+) -> Result<(), JSONRPCErrorError> {
+    if let Some(bound_provider) = bound_provider
+        && config.model_provider_id != bound_provider
+    {
+        let model = config
+            .model
+            .as_deref()
+            .or(persisted_model)
+            .unwrap_or("<default>");
+        return Err(invalid_request(format!(
+            "model `{model}` resolves to model provider `{}` and cannot run on session provider `{bound_provider}`",
+            config.model_provider_id
+        )));
+    }
+    Ok(())
+}
+
+pub(super) async fn ensure_running_resume_provider_binding(
+    thread: &CodexThread,
+    params: &ThreadResumeParams,
+    snapshot: &ThreadConfigSnapshot,
+) -> Result<(), JSONRPCErrorError> {
+    let requested_model = params.model.as_deref().or_else(|| {
+        params
+            .config
+            .as_ref()
+            .and_then(|config| config.get("model"))
+            .and_then(serde_json::Value::as_str)
+    });
+    let requested_provider = params.model_provider.as_deref().or_else(|| {
+        params
+            .config
+            .as_ref()
+            .and_then(|config| config.get("model_provider"))
+            .and_then(serde_json::Value::as_str)
+    });
+    if let Some(model) = requested_model {
+        let thread_config = thread.config().await;
+        ensure_model_provider_binding(thread_config.as_ref(), &snapshot.model_provider_id, model)?;
+    }
+    if let Some(provider) = requested_provider
+        && provider != snapshot.model_provider_id
+    {
+        let model = requested_model.unwrap_or(&snapshot.model);
+        return Err(invalid_request(format!(
+            "model `{model}` requests model provider `{provider}` and cannot run on session provider `{}`",
+            snapshot.model_provider_id
+        )));
+    }
+    Ok(())
+}

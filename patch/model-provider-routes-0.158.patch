+/// A thread's provider cannot change when its model changes on a later turn.
+fn ensure_model_provider_binding(
+    config: &Config,
+    bound_provider: &str,
+    model: &str,
+) -> Result<(), JSONRPCErrorError> {
+    let selected_provider = config
+        .model_provider_routes
+        .get(model)
+        .map(String::as_str)
+        .unwrap_or(&config.unrouted_model_provider_id);
+    if selected_provider != bound_provider {
+        return Err(invalid_request(format!(
+            "model `{model}` resolves to model provider `{selected_provider}` and cannot run on session provider `{bound_provider}`"
+        )));
+    }
+    Ok(())
+}

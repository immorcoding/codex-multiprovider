+async fn model_selection_spawn_case(
+    source: &str,
+    target_provider: &str,
+    default_role_model: Option<&str>,
+) -> (
+    Arc<crate::session::session::Session>,
+    Arc<TurnContext>,
+    ThreadManager,
+    ThreadId,
+    serde_json::Value,
+) {
+    let (mut session, mut turn) = make_session_and_context().await;
+    let manager = thread_manager();
+    let root = manager
+        .start_thread(StartThreadOptions::new((*turn.config).clone()))
+        .await
+        .expect("root thread should start");
+    set_agent_control(&mut session, manager.agent_control());
+    session.thread_id = root.thread_id;
+    let mut config = (*turn.config).clone();
+    config
+        .model_provider_routes
+        .insert("gpt-5.5".to_string(), target_provider.to_string());
+    config.features.enable(Feature::MultiAgentV2).unwrap();
+    if source == "system_default" {
+        config.agent_default_subagent_model = Some("gpt-5.5".to_string());
+    }
+    if let Some(role_model) = default_role_model {
+        let path = config.codex_home.join("default-role-model.toml");
+        tokio::fs::create_dir_all(&config.codex_home).await.unwrap();
+        tokio::fs::write(&path, format!("model = \"{role_model}\"\n"))
+            .await
+            .unwrap();
+        config.agent_roles.insert(
+            "default".to_string(),
+            AgentRoleConfig {
+                description: None,
+                config_file: Some(path.to_path_buf()),
+                nickname_candidates: None,
+            },
+        );
+    }
+    set_turn_config(&mut turn, config);
+    let mut args = json!({"message": "inspect", "task_name": "worker", "fork_turns": "none"});
+    if source == "explicit" {
+        args["model"] = json!("gpt-5.5");
+    }
+    (
+        Arc::new(session),
+        Arc::new(turn),
+        manager,
+        root.thread_id,
+        args,
+    )
+}

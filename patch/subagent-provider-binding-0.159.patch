+#[tokio::test]
+async fn spawn_agent_executes_same_provider_models_from_each_selection_source() {
+    for source in ["explicit", "role", "system_default"] {
+        let (session, turn, manager, _root_id, args) =
+            model_selection_spawn_case(source, "openai", (source == "role").then_some("gpt-5.5"))
+                .await;
+        let output = SpawnAgentHandlerV2::default()
+            .handle(invocation(
+                session.clone(),
+                turn.clone(),
+                "spawn_agent",
+                function_payload(args),
+            ))
+            .await
+            .unwrap_or_else(|err| panic!("{source} same-provider spawn failed: {err}"));
+        let (content, success) = expect_text_output(output);
+        assert_eq!(success, Some(true), "{source}: {content}");
+        let child_id = session
+            .services
+            .local_agent_runtime
+            .resolve_agent_reference(session.thread_id, &turn.session_source, "worker")
+            .await
+            .expect("spawned child should resolve");
+        let snapshot = manager
+            .get_thread(child_id)
+            .await
+            .expect("child should exist")
+            .config_snapshot()
+            .await;
+        assert_eq!(snapshot.model, "gpt-5.5", "{source}");
+        assert_eq!(snapshot.model_provider_id, "openai", "{source}");
+    }
+}

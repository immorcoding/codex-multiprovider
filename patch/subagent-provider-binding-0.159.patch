+#[tokio::test]
+async fn spawn_agent_rejects_cross_provider_models_from_each_selection_source() {
+    for source in ["explicit", "role", "system_default"] {
+        let (session, turn, manager, root_id, args) =
+            model_selection_spawn_case(source, "ollama", (source == "role").then_some("gpt-5.5"))
+                .await;
+        let result = SpawnAgentHandlerV2::default()
+            .handle(invocation(
+                session,
+                turn,
+                "spawn_agent",
+                function_payload(args),
+            ))
+            .await;
+        let Err(FunctionCallError::RespondToModel(message)) = result else {
+            panic!("{source} must reject a cross-provider child model");
+        };
+        assert!(message.contains("gpt-5.5"), "{source}: {message}");
+        assert!(message.contains("ollama"), "{source}: {message}");
+        assert!(message.contains("openai"), "{source}: {message}");
+        assert!(manager.get_thread(root_id).await.is_ok());
+    }
+}

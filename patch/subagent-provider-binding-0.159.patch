+fn ensure_child_model_provider_binding(
+    config: &Config,
+    parent_provider: &str,
+    inherited_model: &str,
+) -> Result<(), String> {
+    let model = config.model.as_deref().ok_or_else(|| {
+        "spawn_agent could not resolve the child model for provider binding".to_string()
+    })?;
+    let target_provider = config
+        .model_provider_routes
+        .get(model)
+        .map(String::as_str)
+        .unwrap_or_else(|| {
+            if model == inherited_model {
+                parent_provider
+            } else {
+                &config.unrouted_model_provider_id
+            }
+        });
+    if target_provider != parent_provider {
+        return Err(format!(
+            "subagent model `{model}` resolves to model provider `{target_provider}` and cannot run on parent provider `{parent_provider}`"
+        ));
+    }
+    Ok(())
+}
